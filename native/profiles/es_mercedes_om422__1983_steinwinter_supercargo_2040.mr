// mtes-real-spec-profile: 1
import "engine_sim.mr"

units units()
constants constants()
impulse_response_library ir_lib()

private node motor_town_flame_speed {
    alias output __out:
        function(5.0)
            .add_sample(0.0, 27.0000)
            .add_sample(5.0, 67.5000)
            .add_sample(10.0, 135.0000)
            .add_sample(15.0, 202.5000)
            .add_sample(20.0, 270.0000)
            .add_sample(25.0, 337.5000)
            .add_sample(30.0, 405.0000)
            .add_sample(35.0, 472.5000)
            .add_sample(40.0, 540.0000)
            .add_sample(45.0, 607.5000);
}

public node motor_town_engine {
    alias output __out: engine;

    engine engine(
        name: "Mercedes OM 422 14.6 V8 diesel",
        starter_torque: 200 * units.lb_ft,
        starter_speed: 200 * units.rpm,
        redline: 2500 * units.rpm,
        throttle_gamma: 2.0,
        fuel: fuel(name: "Diesel", molecular_mass: 167 * units.g, energy_density: 45.5 * units.kJ / units.g, density: 0.832 * units.kg / units.L, molecular_afr: 17.75, turbulence_to_flame_speed_ratio: motor_town_flame_speed(), max_burning_efficiency: 0.44),
        simulation_frequency: 10000
    )

    crankshaft c0(
        throw: 0.071000 * units.m,
        flywheel_mass: 32.688 * units.kg,
        mass: 58.472 * units.kg,
        friction_torque: 46.531 * units.N * units.m,
        moment_of_inertia: 1.501883 * units.kg * units.m * units.m,
        position_x: 0.0, position_y: 0.0,
        tdc: 45.0000 * units.deg
    )
    rod_journal rj1(angle: 90.0000 * units.deg)
    c0.add_rod_journal(rj1)
    rod_journal rj2(angle: 0.0000 * units.deg)
    c0.add_rod_journal(rj2)
    rod_journal rj3(angle: 180.0000 * units.deg)
    c0.add_rod_journal(rj3)
    rod_journal rj4(angle: 270.0000 * units.deg)
    c0.add_rod_journal(rj4)
    rod_journal rj5(angle: 90.0000 * units.deg)
    c0.add_rod_journal(rj5)
    rod_journal rj6(angle: 0.0000 * units.deg)
    c0.add_rod_journal(rj6)
    rod_journal rj7(angle: 180.0000 * units.deg)
    c0.add_rod_journal(rj7)
    rod_journal rj8(angle: 270.0000 * units.deg)
    c0.add_rod_journal(rj8)
    engine.add_crankshaft(c0)

    piston_parameters piston_params(mass: 943.7 * units.g,
        compression_height: 0.042240 * units.m,
        wrist_pin_position: 0.0, displacement: 0.0)
    connecting_rod_parameters rod_params(mass: 613.4 * units.g,
        moment_of_inertia: 0.00280620 * units.kg * units.m * units.m,
        center_of_mass: 0.0, length: 0.234300 * units.m)
    intake intake(
        plenum_volume: 1.4618 * units.L,
        plenum_cross_section_area: 308.337 * units.cm2,
        intake_flow_rate: k_carb(3871.7),
        runner_flow_rate: k_carb(2400.6),
        molecular_afr: 32.1719,
        runner_length: 0.25 * units.m,
        idle_flow_rate: k_carb(0.0),
        idle_throttle_plate_position: 0.99582,
        velocity_decay: 0.5)
    exhaust_system_parameters exhaust_params(
        collector_cross_section_area: 81.713 * units.cm2,
        length: 4.000 * units.m,
        outlet_flow_rate: k_carb(5089.6),
        primary_tube_length: 0.300 * units.m,
        primary_flow_rate: k_carb(1536.4),
        velocity_decay: 1.0, audio_volume: 1.0)
    exhaust_system exhaust0(exhaust_params, impulse_response: ir_lib.mild_exhaust_0_reverb)

    function intake_flow(50 * units.thou)
    intake_flow.add_sample(0 * units.thou, k_28inH2O(0.00))
    intake_flow.add_sample(50 * units.thou, k_28inH2O(36.34))
    intake_flow.add_sample(100 * units.thou, k_28inH2O(72.68))
    intake_flow.add_sample(150 * units.thou, k_28inH2O(109.02))
    intake_flow.add_sample(200 * units.thou, k_28inH2O(145.35))
    intake_flow.add_sample(250 * units.thou, k_28inH2O(181.69))
    intake_flow.add_sample(300 * units.thou, k_28inH2O(218.03))
    intake_flow.add_sample(350 * units.thou, k_28inH2O(254.37))
    intake_flow.add_sample(400 * units.thou, k_28inH2O(290.71))
    intake_flow.add_sample(450 * units.thou, k_28inH2O(327.05))
    intake_flow.add_sample(500 * units.thou, k_28inH2O(363.39))
    intake_flow.add_sample(550 * units.thou, k_28inH2O(373.57))
    intake_flow.add_sample(600 * units.thou, k_28inH2O(373.57))
    intake_flow.add_sample(650 * units.thou, k_28inH2O(373.57))
    intake_flow.add_sample(700 * units.thou, k_28inH2O(373.57))
    intake_flow.add_sample(750 * units.thou, k_28inH2O(373.57))
    intake_flow.add_sample(800 * units.thou, k_28inH2O(373.57))
    harmonic_cam_lobe intake_lobe(duration_at_50_thou: 209.05 * units.deg,
        gamma: 1.1, lift: 0.017203 * units.m, steps: 256)
    function exhaust_flow(50 * units.thou)
    exhaust_flow.add_sample(0 * units.thou, k_28inH2O(0.00))
    exhaust_flow.add_sample(50 * units.thou, k_28inH2O(29.07))
    exhaust_flow.add_sample(100 * units.thou, k_28inH2O(58.14))
    exhaust_flow.add_sample(150 * units.thou, k_28inH2O(87.21))
    exhaust_flow.add_sample(200 * units.thou, k_28inH2O(116.28))
    exhaust_flow.add_sample(250 * units.thou, k_28inH2O(145.35))
    exhaust_flow.add_sample(300 * units.thou, k_28inH2O(174.42))
    exhaust_flow.add_sample(350 * units.thou, k_28inH2O(203.50))
    exhaust_flow.add_sample(400 * units.thou, k_28inH2O(232.57))
    exhaust_flow.add_sample(450 * units.thou, k_28inH2O(239.09))
    exhaust_flow.add_sample(500 * units.thou, k_28inH2O(239.09))
    exhaust_flow.add_sample(550 * units.thou, k_28inH2O(239.09))
    exhaust_flow.add_sample(600 * units.thou, k_28inH2O(239.09))
    exhaust_flow.add_sample(650 * units.thou, k_28inH2O(239.09))
    exhaust_flow.add_sample(700 * units.thou, k_28inH2O(239.09))
    exhaust_flow.add_sample(750 * units.thou, k_28inH2O(239.09))
    exhaust_flow.add_sample(800 * units.thou, k_28inH2O(239.09))
    harmonic_cam_lobe exhaust_lobe(duration_at_50_thou: 209.05 * units.deg,
        gamma: 1.1, lift: 0.017203 * units.m, steps: 256)

    camshaft intake_cam0(advance: 0.0, base_radius: 0.5 * units.inch, lobe_profile: intake_lobe, lobes_per_cycle: 1)
    camshaft exhaust_cam0(advance: 0.0, base_radius: 0.5 * units.inch, lobe_profile: exhaust_lobe, lobes_per_cycle: 1)
    cylinder_bank b0(angle: -45.0000 * units.deg, bore: 0.128000 * units.m,
        deck_height: 0.347540 * units.m)
    intake_cam0.add_lobe((472.0 + 90.0000) * units.deg)
    exhaust_cam0.add_lobe((248.0 + 90.0000) * units.deg)
    ignition_wire wire5()
    b0.add_cylinder(
        piston: piston(piston_params, blowby: k_28inH2O(0.0)),
        connecting_rod: connecting_rod(rod_params),
        rod_journal: rj5, intake: intake, exhaust_system: exhaust0,
        ignition_wire: wire5, sound_attenuation: 1.0,
        primary_length: 0.4916 * units.m)
    intake_cam0.add_lobe((472.0 + 360.0000) * units.deg)
    exhaust_cam0.add_lobe((248.0 + 360.0000) * units.deg)
    ignition_wire wire6()
    b0.add_cylinder(
        piston: piston(piston_params, blowby: k_28inH2O(0.0)),
        connecting_rod: connecting_rod(rod_params),
        rod_journal: rj6, intake: intake, exhaust_system: exhaust0,
        ignition_wire: wire6, sound_attenuation: 1.0,
        primary_length: 0.3444 * units.m)
    intake_cam0.add_lobe((472.0 + 180.0000) * units.deg)
    exhaust_cam0.add_lobe((248.0 + 180.0000) * units.deg)
    ignition_wire wire7()
    b0.add_cylinder(
        piston: piston(piston_params, blowby: k_28inH2O(0.0)),
        connecting_rod: connecting_rod(rod_params),
        rod_journal: rj7, intake: intake, exhaust_system: exhaust0,
        ignition_wire: wire7, sound_attenuation: 1.0,
        primary_length: 0.1972 * units.m)
    intake_cam0.add_lobe((472.0 + 630.0000) * units.deg)
    exhaust_cam0.add_lobe((248.0 + 630.0000) * units.deg)
    ignition_wire wire8()
    b0.add_cylinder(
        piston: piston(piston_params, blowby: k_28inH2O(0.0)),
        connecting_rod: connecting_rod(rod_params),
        rod_journal: rj8, intake: intake, exhaust_system: exhaust0,
        ignition_wire: wire8, sound_attenuation: 1.0,
        primary_length: 0.0500 * units.m)
    b0.set_cylinder_head(generic_cylinder_head(
        chamber_volume: 114.203 * units.cc,
        intake_runner_volume: 246.670 * units.cc,
        intake_runner_cross_section_area: 38.5421 * units.cm2,
        exhaust_runner_volume: 897.877 * units.cc,
        exhaust_runner_cross_section_area: 24.6670 * units.cm2,
        intake_port_flow: intake_flow, exhaust_port_flow: exhaust_flow,
        valvetrain: standard_valvetrain(intake_camshaft: intake_cam0, exhaust_camshaft: exhaust_cam0),
        flip_display: false))
    engine.add_cylinder_bank(b0)

    camshaft intake_cam1(advance: 0.0, base_radius: 0.5 * units.inch, lobe_profile: intake_lobe, lobes_per_cycle: 1)
    camshaft exhaust_cam1(advance: 0.0, base_radius: 0.5 * units.inch, lobe_profile: exhaust_lobe, lobes_per_cycle: 1)
    cylinder_bank b1(angle: 45.0000 * units.deg, bore: 0.128000 * units.m,
        deck_height: 0.347540 * units.m)
    intake_cam1.add_lobe((472.0 + 0.0000) * units.deg)
    exhaust_cam1.add_lobe((248.0 + 0.0000) * units.deg)
    ignition_wire wire1()
    b1.add_cylinder(
        piston: piston(piston_params, blowby: k_28inH2O(0.0)),
        connecting_rod: connecting_rod(rod_params),
        rod_journal: rj1, intake: intake, exhaust_system: exhaust0,
        ignition_wire: wire1, sound_attenuation: 1.0,
        primary_length: 0.4916 * units.m)
    intake_cam1.add_lobe((472.0 + 270.0000) * units.deg)
    exhaust_cam1.add_lobe((248.0 + 270.0000) * units.deg)
    ignition_wire wire2()
    b1.add_cylinder(
        piston: piston(piston_params, blowby: k_28inH2O(0.0)),
        connecting_rod: connecting_rod(rod_params),
        rod_journal: rj2, intake: intake, exhaust_system: exhaust0,
        ignition_wire: wire2, sound_attenuation: 1.0,
        primary_length: 0.3444 * units.m)
    intake_cam1.add_lobe((472.0 + 450.0000) * units.deg)
    exhaust_cam1.add_lobe((248.0 + 450.0000) * units.deg)
    ignition_wire wire3()
    b1.add_cylinder(
        piston: piston(piston_params, blowby: k_28inH2O(0.0)),
        connecting_rod: connecting_rod(rod_params),
        rod_journal: rj3, intake: intake, exhaust_system: exhaust0,
        ignition_wire: wire3, sound_attenuation: 1.0,
        primary_length: 0.1972 * units.m)
    intake_cam1.add_lobe((472.0 + 540.0000) * units.deg)
    exhaust_cam1.add_lobe((248.0 + 540.0000) * units.deg)
    ignition_wire wire4()
    b1.add_cylinder(
        piston: piston(piston_params, blowby: k_28inH2O(0.0)),
        connecting_rod: connecting_rod(rod_params),
        rod_journal: rj4, intake: intake, exhaust_system: exhaust0,
        ignition_wire: wire4, sound_attenuation: 1.0,
        primary_length: 0.0500 * units.m)
    b1.set_cylinder_head(generic_cylinder_head(
        chamber_volume: 114.203 * units.cc,
        intake_runner_volume: 246.670 * units.cc,
        intake_runner_cross_section_area: 38.5421 * units.cm2,
        exhaust_runner_volume: 897.877 * units.cc,
        exhaust_runner_cross_section_area: 24.6670 * units.cm2,
        intake_port_flow: intake_flow, exhaust_port_flow: exhaust_flow,
        valvetrain: standard_valvetrain(intake_camshaft: intake_cam1, exhaust_camshaft: exhaust_cam1),
        flip_display: true))
    engine.add_cylinder_bank(b1)

    function timing_curve(1000 * units.rpm)
    timing_curve.add_sample(0 * units.rpm, 8.61 * units.deg)
    timing_curve.add_sample(500 * units.rpm, 8.61 * units.deg)
    timing_curve.add_sample(1000 * units.rpm, 8.61 * units.deg)
    timing_curve.add_sample(1500 * units.rpm, 9.72 * units.deg)
    timing_curve.add_sample(2000 * units.rpm, 10.84 * units.deg)
    timing_curve.add_sample(2500 * units.rpm, 9.98 * units.deg)
    timing_curve.add_sample(3000 * units.rpm, 9.98 * units.deg)
    timing_curve.add_sample(3500 * units.rpm, 9.98 * units.deg)
    timing_curve.add_sample(4000 * units.rpm, 9.98 * units.deg)
    timing_curve.add_sample(4500 * units.rpm, 9.98 * units.deg)
    ignition_module ignition_module(timing_curve: timing_curve, rev_limit: 2800 * units.rpm, limiter_duration: 0.1, sparks_per_cycle: 1)
    ignition_module.connect_wire(wire1, 0.0000 * units.deg)
    ignition_module.connect_wire(wire5, 90.0000 * units.deg)
    ignition_module.connect_wire(wire7, 180.0000 * units.deg)
    ignition_module.connect_wire(wire2, 270.0000 * units.deg)
    ignition_module.connect_wire(wire6, 360.0000 * units.deg)
    ignition_module.connect_wire(wire3, 450.0000 * units.deg)
    ignition_module.connect_wire(wire4, 540.0000 * units.deg)
    ignition_module.connect_wire(wire8, 630.0000 * units.deg)
    engine.add_ignition_module(ignition_module)
}

public node main {
    set_engine(motor_town_engine())
    set_vehicle(vehicle(mass: 1500 * units.kg, drag_coefficient: 0.35,
        cross_sectional_area: 2.0 * units.m * units.m, diff_ratio: 3.42,
        tire_radius: 0.33 * units.m, rolling_resistance: 200 * units.N))
    set_transmission(transmission(max_clutch_torque: 1000 * units.lb_ft).add_gear(1.0))
}

main()

// mtes-real-spec-profile: 1
import "engine_sim.mr"

units units()
constants constants()
impulse_response_library ir_lib()

private node motor_town_flame_speed {
    alias output __out:
        function(5.0)
            .add_sample(0.0, 9.0000)
            .add_sample(5.0, 22.5000)
            .add_sample(10.0, 45.0000)
            .add_sample(15.0, 67.5000)
            .add_sample(20.0, 90.0000)
            .add_sample(25.0, 112.5000)
            .add_sample(30.0, 135.0000)
            .add_sample(35.0, 157.5000)
            .add_sample(40.0, 180.0000)
            .add_sample(45.0, 202.5000);
}

public node motor_town_engine {
    alias output __out: engine;

    engine engine(
        name: "Mazda Skyactiv-G 2.0 I4",
        starter_torque: 200 * units.lb_ft,
        starter_speed: 200 * units.rpm,
        redline: 6500 * units.rpm,
        throttle_gamma: 2.0,
        fuel: fuel(name: "Gasoline", turbulence_to_flame_speed_ratio: motor_town_flame_speed(), max_burning_efficiency: 0.44),
        simulation_frequency: 13000
    )

    crankshaft c0(
        throw: 0.045600 * units.m,
        flywheel_mass: 8.116 * units.kg,
        mass: 7.991 * units.kg,
        friction_torque: 6.359 * units.N * units.m,
        moment_of_inertia: 0.134246 * units.kg * units.m * units.m,
        position_x: 0.0, position_y: 0.0,
        tdc: 90.0000 * units.deg
    )
    rod_journal rj1(angle: 0.0000 * units.deg)
    c0.add_rod_journal(rj1)
    rod_journal rj2(angle: 180.0000 * units.deg)
    c0.add_rod_journal(rj2)
    rod_journal rj3(angle: 180.0000 * units.deg)
    c0.add_rod_journal(rj3)
    rod_journal rj4(angle: 0.0000 * units.deg)
    c0.add_rod_journal(rj4)
    engine.add_crankshaft(c0)

    piston_parameters piston_params(mass: 262.0 * units.g,
        compression_height: 0.027555 * units.m,
        wrist_pin_position: 0.0, displacement: 0.0)
    connecting_rod_parameters rod_params(mass: 170.3 * units.g,
        moment_of_inertia: 0.00032134 * units.kg * units.m * units.m,
        center_of_mass: 0.0, length: 0.150480 * units.m)
    intake intake(
        plenum_volume: 1.9976 * units.L,
        plenum_cross_section_area: 73.808 * units.cm2,
        intake_flow_rate: k_carb(1375.6),
        runner_flow_rate: k_carb(1149.3),
        molecular_afr: 12.5000,
        runner_length: 0.25 * units.m,
        idle_flow_rate: k_carb(0.0),
        idle_throttle_plate_position: 0.99769,
        velocity_decay: 0.5)
    exhaust_system_parameters exhaust_params(
        collector_cross_section_area: 19.635 * units.cm2,
        length: 3.540 * units.m,
        outlet_flow_rate: k_carb(1223.0),
        primary_tube_length: 0.750 * units.m,
        primary_flow_rate: k_carb(735.5),
        velocity_decay: 1.0, audio_volume: 1.0)
    exhaust_system exhaust0(exhaust_params, impulse_response: ir_lib.minimal_muffling_01)

    function intake_flow(50 * units.thou)
    intake_flow.add_sample(0 * units.thou, k_28inH2O(0.00))
    intake_flow.add_sample(50 * units.thou, k_28inH2O(35.56))
    intake_flow.add_sample(100 * units.thou, k_28inH2O(71.12))
    intake_flow.add_sample(150 * units.thou, k_28inH2O(106.67))
    intake_flow.add_sample(200 * units.thou, k_28inH2O(142.23))
    intake_flow.add_sample(250 * units.thou, k_28inH2O(177.79))
    intake_flow.add_sample(300 * units.thou, k_28inH2O(178.85))
    intake_flow.add_sample(350 * units.thou, k_28inH2O(178.85))
    intake_flow.add_sample(400 * units.thou, k_28inH2O(178.85))
    intake_flow.add_sample(450 * units.thou, k_28inH2O(178.85))
    harmonic_cam_lobe intake_lobe(duration_at_50_thou: 230.19 * units.deg,
        gamma: 1.1, lift: 0.008417 * units.m, steps: 256)
    function exhaust_flow(50 * units.thou)
    exhaust_flow.add_sample(0 * units.thou, k_28inH2O(0.00))
    exhaust_flow.add_sample(50 * units.thou, k_28inH2O(28.45))
    exhaust_flow.add_sample(100 * units.thou, k_28inH2O(56.89))
    exhaust_flow.add_sample(150 * units.thou, k_28inH2O(85.34))
    exhaust_flow.add_sample(200 * units.thou, k_28inH2O(113.78))
    exhaust_flow.add_sample(250 * units.thou, k_28inH2O(114.46))
    exhaust_flow.add_sample(300 * units.thou, k_28inH2O(114.46))
    exhaust_flow.add_sample(350 * units.thou, k_28inH2O(114.46))
    exhaust_flow.add_sample(400 * units.thou, k_28inH2O(114.46))
    exhaust_flow.add_sample(450 * units.thou, k_28inH2O(114.46))
    harmonic_cam_lobe exhaust_lobe(duration_at_50_thou: 230.19 * units.deg,
        gamma: 1.1, lift: 0.008417 * units.m, steps: 256)

    camshaft intake_cam0(advance: 0.0, base_radius: 0.5 * units.inch, lobe_profile: intake_lobe, lobes_per_cycle: 1)
    camshaft exhaust_cam0(advance: 0.0, base_radius: 0.5 * units.inch, lobe_profile: exhaust_lobe, lobes_per_cycle: 1)
    cylinder_bank b0(angle: 0.0000 * units.deg, bore: 0.083500 * units.m,
        deck_height: 0.223635 * units.m)
    intake_cam0.add_lobe((472.0 + 0.0000) * units.deg)
    exhaust_cam0.add_lobe((248.0 + 0.0000) * units.deg)
    ignition_wire wire1()
    b0.add_cylinder(
        piston: piston(piston_params, blowby: k_28inH2O(0.0)),
        connecting_rod: connecting_rod(rod_params),
        rod_journal: rj1, intake: intake, exhaust_system: exhaust0,
        ignition_wire: wire1, sound_attenuation: 1.0,
        primary_length: 0.3381 * units.m)
    intake_cam0.add_lobe((472.0 + 540.0000) * units.deg)
    exhaust_cam0.add_lobe((248.0 + 540.0000) * units.deg)
    ignition_wire wire2()
    b0.add_cylinder(
        piston: piston(piston_params, blowby: k_28inH2O(0.0)),
        connecting_rod: connecting_rod(rod_params),
        rod_journal: rj2, intake: intake, exhaust_system: exhaust0,
        ignition_wire: wire2, sound_attenuation: 1.0,
        primary_length: 0.2420 * units.m)
    intake_cam0.add_lobe((472.0 + 180.0000) * units.deg)
    exhaust_cam0.add_lobe((248.0 + 180.0000) * units.deg)
    ignition_wire wire3()
    b0.add_cylinder(
        piston: piston(piston_params, blowby: k_28inH2O(0.0)),
        connecting_rod: connecting_rod(rod_params),
        rod_journal: rj3, intake: intake, exhaust_system: exhaust0,
        ignition_wire: wire3, sound_attenuation: 1.0,
        primary_length: 0.1460 * units.m)
    intake_cam0.add_lobe((472.0 + 360.0000) * units.deg)
    exhaust_cam0.add_lobe((248.0 + 360.0000) * units.deg)
    ignition_wire wire4()
    b0.add_cylinder(
        piston: piston(piston_params, blowby: k_28inH2O(0.0)),
        connecting_rod: connecting_rod(rod_params),
        rod_journal: rj4, intake: intake, exhaust_system: exhaust0,
        ignition_wire: wire4, sound_attenuation: 1.0,
        primary_length: 0.0500 * units.m)
    b0.set_cylinder_head(generic_cylinder_head(
        chamber_volume: 41.618 * units.cc,
        intake_runner_volume: 77.037 * units.cc,
        intake_runner_cross_section_area: 18.4519 * units.cm2,
        exhaust_runner_volume: 49.303 * units.cc,
        exhaust_runner_cross_section_area: 11.8092 * units.cm2,
        intake_port_flow: intake_flow, exhaust_port_flow: exhaust_flow,
        valvetrain: standard_valvetrain(intake_camshaft: intake_cam0, exhaust_camshaft: exhaust_cam0),
        flip_display: false))
    engine.add_cylinder_bank(b0)

    function timing_curve(1000 * units.rpm)
    timing_curve.add_sample(0 * units.rpm, 29.72 * units.deg)
    timing_curve.add_sample(500 * units.rpm, 29.72 * units.deg)
    timing_curve.add_sample(1000 * units.rpm, 29.72 * units.deg)
    timing_curve.add_sample(1500 * units.rpm, 29.72 * units.deg)
    timing_curve.add_sample(2000 * units.rpm, 29.72 * units.deg)
    timing_curve.add_sample(2500 * units.rpm, 26.80 * units.deg)
    timing_curve.add_sample(3000 * units.rpm, 23.89 * units.deg)
    timing_curve.add_sample(3500 * units.rpm, 23.20 * units.deg)
    timing_curve.add_sample(4000 * units.rpm, 22.51 * units.deg)
    timing_curve.add_sample(4500 * units.rpm, 20.28 * units.deg)
    timing_curve.add_sample(5000 * units.rpm, 18.05 * units.deg)
    timing_curve.add_sample(5500 * units.rpm, 16.25 * units.deg)
    timing_curve.add_sample(6000 * units.rpm, 14.44 * units.deg)
    timing_curve.add_sample(6500 * units.rpm, 23.89 * units.deg)
    timing_curve.add_sample(7000 * units.rpm, 23.89 * units.deg)
    timing_curve.add_sample(7500 * units.rpm, 23.89 * units.deg)
    timing_curve.add_sample(8000 * units.rpm, 23.89 * units.deg)
    timing_curve.add_sample(8500 * units.rpm, 23.89 * units.deg)
    ignition_module ignition_module(timing_curve: timing_curve, rev_limit: 6800 * units.rpm, limiter_duration: 0.1, sparks_per_cycle: 1)
    ignition_module.connect_wire(wire1, 0.0000 * units.deg)
    ignition_module.connect_wire(wire3, 180.0000 * units.deg)
    ignition_module.connect_wire(wire4, 360.0000 * units.deg)
    ignition_module.connect_wire(wire2, 540.0000 * units.deg)
    engine.add_ignition_module(ignition_module)
}

public node main {
    set_engine(motor_town_engine())
    set_vehicle(vehicle(mass: 1500 * units.kg, drag_coefficient: 0.35,
        cross_sectional_area: 2.0 * units.m * units.m, diff_ratio: 3.42,
        tire_radius: 0.33 * units.m, rolling_resistance: 200 * units.N))
    set_transmission(transmission(max_clutch_torque: 1000 * units.lb_ft).add_gear(1.0))
}

main()

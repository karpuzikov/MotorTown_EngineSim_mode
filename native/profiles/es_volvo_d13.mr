// Volvo D13 12.8 I6 diesel (FM, VNL): 6 cyl, 12.78 L, bore 131.0 x stroke 158.0 mm,
// firing order 1-5-3-6-2-4, redline 2200 rpm. Generated by
// native/profiles/generator/make_engines.py from real_engines.py.
import "engine_sim.mr"

units units()
constants constants()
impulse_response_library ir_lib()

private node wires {
    output wire1: ignition_wire();
    output wire2: ignition_wire();
    output wire3: ignition_wire();
    output wire4: ignition_wire();
    output wire5: ignition_wire();
    output wire6: ignition_wire();
}

private node head {
    input intake_camshaft;
    input exhaust_camshaft;
    input flip_display: false;
    alias output __out: head;
    function intake_flow(50 * units.thou * 0.8167)
    intake_flow
        .add_flow_sample(0 * 0.8167, 0 * 1.8621)
        .add_flow_sample(50 * 0.8167, 1 * 1.8621)
        .add_flow_sample(100 * 0.8167, 103 * 1.8621)
        .add_flow_sample(150 * 0.8167, 156 * 1.8621)
        .add_flow_sample(200 * 0.8167, 214 * 1.8621)
        .add_flow_sample(250 * 0.8167, 249 * 1.8621)
        .add_flow_sample(300 * 0.8167, 268 * 1.8621)
        .add_flow_sample(350 * 0.8167, 280 * 1.8621)
        .add_flow_sample(400 * 0.8167, 280 * 1.8621)
        .add_flow_sample(450 * 0.8167, 281 * 1.8621)
    function exhaust_flow(50 * units.thou * 0.8167)
    exhaust_flow
        .add_flow_sample(0 * 0.8167, 0 * 1.8621)
        .add_flow_sample(50 * 0.8167, 1 * 1.8621)
        .add_flow_sample(100 * 0.8167, 72 * 1.8621)
        .add_flow_sample(150 * 0.8167, 113 * 1.8621)
        .add_flow_sample(200 * 0.8167, 160 * 1.8621)
        .add_flow_sample(250 * 0.8167, 196 * 1.8621)
        .add_flow_sample(300 * 0.8167, 222 * 1.8621)
        .add_flow_sample(350 * 0.8167, 235 * 1.8621)
        .add_flow_sample(400 * 0.8167, 245 * 1.8621)
        .add_flow_sample(450 * 0.8167, 246 * 1.8621)
    generic_cylinder_head head(
        chamber_volume: 133.10 * units.cc,
        intake_runner_volume: 447.45 * units.cc,
        intake_runner_cross_section_area: 14.476 * units.inch * units.inch,
        exhaust_runner_volume: 149.55 * units.cc,
        exhaust_runner_cross_section_area: 9.160 * units.inch * units.inch,
        intake_port_flow: intake_flow,
        exhaust_port_flow: exhaust_flow,
        valvetrain: standard_valvetrain(intake_camshaft: intake_camshaft, exhaust_camshaft: exhaust_camshaft),
        flip_display: flip_display
    )
}

private node turbulence_to_flame_speed_ratio {
    alias output __out:
        function(5.0)
            .add_sample(0.0, 3.0)
            .add_sample(5.0, 1.5 * 5.0)
            .add_sample(10.0, 1.75 * 10.0)
            .add_sample(15.0, 2.0 * 15.0)
            .add_sample(20.0, 2.0 * 20.0)
            .add_sample(25.0, 2.0 * 25.0)
            .add_sample(30.0, 2.0 * 30.0)
            .add_sample(35.0, 2.0 * 35.0)
            .add_sample(40.0, 2.0 * 40.0)
            .add_sample(45.0, 2.0 * 45.0)
            ;
}

private node camshafts {
    input lsa: 114 * units.deg;
    output intake0: _intake0;
    output exhaust0: _exhaust0;
    label rot360(360 * units.deg)
    camshaft_parameters params(advance: 0 * units.deg, base_radius: 0.75 * units.inch)
    harmonic_cam_lobe intake_lobe(
        duration_at_50_thou: 200 * units.deg, gamma: 1.1,
        lift: 450 * units.thou, steps: 256)
    harmonic_cam_lobe exhaust_lobe(
        duration_at_50_thou: 204 * units.deg, gamma: 1.1,
        lift: 450 * units.thou, steps: 256)
    camshaft _intake0(params, lobe_profile: intake_lobe)
    camshaft _exhaust0(params, lobe_profile: exhaust_lobe)
    _exhaust0
        .add_lobe(rot360 - lsa + 0.000 * units.deg) // cyl 1
        .add_lobe(rot360 - lsa + 480.000 * units.deg) // cyl 2
        .add_lobe(rot360 - lsa + 240.000 * units.deg) // cyl 3
        .add_lobe(rot360 - lsa + 600.000 * units.deg) // cyl 4
        .add_lobe(rot360 - lsa + 120.000 * units.deg) // cyl 5
        .add_lobe(rot360 - lsa + 360.000 * units.deg) // cyl 6
    _intake0
        .add_lobe(rot360 + lsa + 0.000 * units.deg) // cyl 1
        .add_lobe(rot360 + lsa + 480.000 * units.deg) // cyl 2
        .add_lobe(rot360 + lsa + 240.000 * units.deg) // cyl 3
        .add_lobe(rot360 + lsa + 600.000 * units.deg) // cyl 4
        .add_lobe(rot360 + lsa + 120.000 * units.deg) // cyl 5
        .add_lobe(rot360 + lsa + 360.000 * units.deg) // cyl 6
}

public node volvo_d13 {
    alias output __out: engine;
    engine engine(
        name: "Volvo D13 12.8 I6 diesel (FM, VNL)",
        starter_torque: 200 * units.lb_ft,
        starter_speed: 200 * units.rpm,
        redline: 2200 * units.rpm,
        throttle_gamma: 2.0,
        fuel: fuel(max_burning_efficiency: 1.0, turbulence_to_flame_speed_ratio: turbulence_to_flame_speed_ratio()),
        hf_gain: 0.01,
        noise: 1.0,
        jitter: 0.4,
        simulation_frequency: 10000
    )

    wires wires()

    label stroke(158.0 * units.mm)
    label bore(131.0 * units.mm)
    label rod_length(268.6 * units.mm)
    label rod_mass(1917 * units.g)
    label compression_height(41.9 * units.mm)
    label crank_mass(95.8 * units.lb)
    label flywheel_mass(29.7 * units.lb)
    label flywheel_radius(6 * units.inch)
    label crank_moment(1.5 * disk_moment_of_inertia(mass: crank_mass, radius: stroke))
    label flywheel_moment(disk_moment_of_inertia(mass: flywheel_mass, radius: flywheel_radius))
    label other_moment(disk_moment_of_inertia(mass: 1 * units.kg, radius: 1.0 * units.cm))

    crankshaft c0(
        throw: stroke / 2,
        flywheel_mass: flywheel_mass,
        mass: crank_mass,
        friction_torque: 44.7 * units.lb_ft,
        moment_of_inertia: crank_moment + flywheel_moment + other_moment,
        position_x: 0.0,
        position_y: 0.0,
        tdc: 90.0 * units.deg
    )

    rod_journal rj1(angle: 0.000 * units.deg)
    rod_journal rj2(angle: 120.000 * units.deg)
    rod_journal rj3(angle: 240.000 * units.deg)
    rod_journal rj4(angle: 240.000 * units.deg)
    rod_journal rj5(angle: 120.000 * units.deg)
    rod_journal rj6(angle: 0.000 * units.deg)
    c0
        .add_rod_journal(rj1)
        .add_rod_journal(rj2)
        .add_rod_journal(rj3)
        .add_rod_journal(rj4)
        .add_rod_journal(rj5)
        .add_rod_journal(rj6)

    piston_parameters piston_params(
        mass: 1278 * units.g,
        compression_height: compression_height,
        wrist_pin_position: 0.0,
        displacement: 0.0
    )
    connecting_rod_parameters cr_params(
        mass: rod_mass,
        moment_of_inertia: rod_moment_of_inertia(mass: rod_mass, length: rod_length),
        center_of_mass: 0.0,
        length: rod_length
    )

    intake intake(
        plenum_volume: 2.939 * units.L,
        plenum_cross_section_area: 44.7 * units.cm2,
        intake_flow_rate: k_carb(471.5),
        runner_flow_rate: k_carb(90.4),
        runner_length: 12.0 * units.inch,
        idle_flow_rate: k_carb(0.0),
        idle_throttle_plate_position: 0.93,
        velocity_decay: 0.5
    )

    exhaust_system_parameters es_params(
        outlet_flow_rate: k_carb(674.3),
        primary_tube_length: 24 * units.inch,
        primary_flow_rate: k_carb(334.8),
        velocity_decay: 1.0
    )
    exhaust_system exhaust0(es_params, audio_volume: 2.0,
        length: 156 * units.inch, impulse_response: ir_lib.default_0)

    cylinder_bank_parameters bank_params(
        bore: bore,
        deck_height: stroke / 2 + rod_length + compression_height
    )
    cylinder_bank b0(bank_params, angle: 0.0 * units.deg)
    b0
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.1)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj1,
            intake: intake,
            exhaust_system: exhaust0,
            ignition_wire: wires.wire1,
            sound_attenuation: 1.0,
            primary_length: 14 * units.inch
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.1)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj2,
            intake: intake,
            exhaust_system: exhaust0,
            ignition_wire: wires.wire2,
            sound_attenuation: 1.0,
            primary_length: 12 * units.inch
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.1)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj3,
            intake: intake,
            exhaust_system: exhaust0,
            ignition_wire: wires.wire3,
            sound_attenuation: 1.0,
            primary_length: 10 * units.inch
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.1)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj4,
            intake: intake,
            exhaust_system: exhaust0,
            ignition_wire: wires.wire4,
            sound_attenuation: 1.0,
            primary_length: 8 * units.inch
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.1)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj5,
            intake: intake,
            exhaust_system: exhaust0,
            ignition_wire: wires.wire5,
            sound_attenuation: 1.0,
            primary_length: 6 * units.inch
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.1)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj6,
            intake: intake,
            exhaust_system: exhaust0,
            ignition_wire: wires.wire6,
            sound_attenuation: 1.0,
            primary_length: 4 * units.inch
        )
        .set_cylinder_head(head(intake_camshaft: camshaft.intake0, exhaust_camshaft: camshaft.exhaust0, flip_display: false))

    engine
        .add_cylinder_bank(b0)
    engine.add_crankshaft(c0)

    camshafts camshaft()
    function timing_curve(1000 * units.rpm)
    timing_curve
        .add_sample(0 * units.rpm, 10.0 * units.deg)
        .add_sample(1000 * units.rpm, 13.6 * units.deg)
        .add_sample(2000 * units.rpm, 14.0 * units.deg)
        .add_sample(3000 * units.rpm, 14.0 * units.deg)
        .add_sample(4000 * units.rpm, 14.0 * units.deg)
        .add_sample(5000 * units.rpm, 14.0 * units.deg)
        .add_sample(6000 * units.rpm, 14.0 * units.deg)
        .add_sample(7000 * units.rpm, 14.0 * units.deg)
        .add_sample(8000 * units.rpm, 14.0 * units.deg)
    ignition_module ignition_module(timing_curve: timing_curve,
        rev_limit: 2500 * units.rpm, limiter_duration: 0.1)
    ignition_module
        .connect_wire(wires.wire1, 0.000 * units.deg)
        .connect_wire(wires.wire5, 120.000 * units.deg)
        .connect_wire(wires.wire3, 240.000 * units.deg)
        .connect_wire(wires.wire6, 360.000 * units.deg)
        .connect_wire(wires.wire2, 480.000 * units.deg)
        .connect_wire(wires.wire4, 600.000 * units.deg)
    engine.add_ignition_module(ignition_module)
}

private node mtes_vehicle {
    alias output __out:
        vehicle(mass: 1600 * units.kg, drag_coefficient: 0.3,
            cross_sectional_area: (72 * units.inch) * (50 * units.inch),
            diff_ratio: 3.42, tire_radius: 10 * units.inch, rolling_resistance: 200 * units.N);
}
private node mtes_transmission {
    alias output __out:
        transmission(max_clutch_torque: 2000 * units.lb_ft)
        .add_gear(2.97).add_gear(2.07).add_gear(1.43).add_gear(1.00).add_gear(0.71);
}
public node main {
    set_engine(volvo_d13())
    set_vehicle(mtes_vehicle())
    set_transmission(mtes_transmission())
}

main()

// mtes-output-gain: 0.000229
// Ford 1.6 Kent I4 (Formula Ford): 4 cyl, 1.60 L, bore 81.0 x stroke 77.6 mm,
// firing order 1-2-4-3, redline 7600 rpm. Generated by
// native/profiles/generator/make_engines.py from real_engines.py.
import "engine_sim.mr"

units units()
constants constants()
impulse_response_library ir_lib()

private node wires {
    output wire1: ignition_wire();
    output wire2: ignition_wire();
    output wire3: ignition_wire();
    output wire4: ignition_wire();
}

private node head {
    input intake_camshaft;
    input exhaust_camshaft;
    input flip_display: false;
    alias output __out: head;
    function intake_flow(50 * units.thou * 0.8167)
    intake_flow
        .add_flow_sample(0 * 0.8167, 0 * 0.7119)
        .add_flow_sample(50 * 0.8167, 1 * 0.7119)
        .add_flow_sample(100 * 0.8167, 103 * 0.7119)
        .add_flow_sample(150 * 0.8167, 156 * 0.7119)
        .add_flow_sample(200 * 0.8167, 214 * 0.7119)
        .add_flow_sample(250 * 0.8167, 249 * 0.7119)
        .add_flow_sample(300 * 0.8167, 268 * 0.7119)
        .add_flow_sample(350 * 0.8167, 280 * 0.7119)
        .add_flow_sample(400 * 0.8167, 280 * 0.7119)
        .add_flow_sample(450 * 0.8167, 281 * 0.7119)
    function exhaust_flow(50 * units.thou * 0.8167)
    exhaust_flow
        .add_flow_sample(0 * 0.8167, 0 * 0.7119)
        .add_flow_sample(50 * 0.8167, 1 * 0.7119)
        .add_flow_sample(100 * 0.8167, 72 * 0.7119)
        .add_flow_sample(150 * 0.8167, 113 * 0.7119)
        .add_flow_sample(200 * 0.8167, 160 * 0.7119)
        .add_flow_sample(250 * 0.8167, 196 * 0.7119)
        .add_flow_sample(300 * 0.8167, 222 * 0.7119)
        .add_flow_sample(350 * 0.8167, 235 * 0.7119)
        .add_flow_sample(400 * 0.8167, 245 * 0.7119)
        .add_flow_sample(450 * 0.8167, 246 * 0.7119)
    generic_cylinder_head head(
        chamber_volume: 42.09 * units.cc,
        intake_runner_volume: 84.02 * units.cc,
        intake_runner_cross_section_area: 2.718 * units.inch * units.inch,
        exhaust_runner_volume: 28.08 * units.cc,
        exhaust_runner_cross_section_area: 1.720 * units.inch * units.inch,
        intake_port_flow: intake_flow,
        exhaust_port_flow: exhaust_flow,
        valvetrain: standard_valvetrain(intake_camshaft: intake_camshaft, exhaust_camshaft: exhaust_camshaft),
        flip_display: flip_display
    )
}

private node turbulence_to_flame_speed_ratio {
    alias output __out:
        function(5.0)
            .add_sample(0.0, 3.0)
            .add_sample(5.0, 1.5 * 5.0)
            .add_sample(10.0, 1.75 * 10.0)
            .add_sample(15.0, 2.0 * 15.0)
            .add_sample(20.0, 2.0 * 20.0)
            .add_sample(25.0, 2.0 * 25.0)
            .add_sample(30.0, 2.0 * 30.0)
            .add_sample(35.0, 2.0 * 35.0)
            .add_sample(40.0, 2.0 * 40.0)
            .add_sample(45.0, 2.0 * 45.0)
            ;
}

private node camshafts {
    input lsa: 110 * units.deg;
    output intake0: _intake0;
    output exhaust0: _exhaust0;
    label rot360(360 * units.deg)
    camshaft_parameters params(advance: 0 * units.deg, base_radius: 0.75 * units.inch)
    harmonic_cam_lobe intake_lobe(
        duration_at_50_thou: 232 * units.deg, gamma: 1.1,
        lift: 450 * units.thou, steps: 256)
    harmonic_cam_lobe exhaust_lobe(
        duration_at_50_thou: 236 * units.deg, gamma: 1.1,
        lift: 450 * units.thou, steps: 256)
    camshaft _intake0(params, lobe_profile: intake_lobe)
    camshaft _exhaust0(params, lobe_profile: exhaust_lobe)
    _exhaust0
        .add_lobe(rot360 - lsa + 0.000 * units.deg) // cyl 1
        .add_lobe(rot360 - lsa + 180.000 * units.deg) // cyl 2
        .add_lobe(rot360 - lsa + 540.000 * units.deg) // cyl 3
        .add_lobe(rot360 - lsa + 360.000 * units.deg) // cyl 4
    _intake0
        .add_lobe(rot360 + lsa + 0.000 * units.deg) // cyl 1
        .add_lobe(rot360 + lsa + 180.000 * units.deg) // cyl 2
        .add_lobe(rot360 + lsa + 540.000 * units.deg) // cyl 3
        .add_lobe(rot360 + lsa + 360.000 * units.deg) // cyl 4
}

public node ford_kent_16 {
    alias output __out: engine;
    engine engine(
        name: "Ford 1.6 Kent I4 (Formula Ford)",
        starter_torque: 200 * units.lb_ft,
        starter_speed: 200 * units.rpm,
        redline: 7600 * units.rpm,
        throttle_gamma: 2.0,
        fuel: fuel(max_burning_efficiency: 1.0, turbulence_to_flame_speed_ratio: turbulence_to_flame_speed_ratio()),
        hf_gain: 0.01,
        noise: 1.0,
        jitter: 0.25,
        simulation_frequency: 20000
    )

    wires wires()

    label stroke(77.6 * units.mm)
    label bore(81.0 * units.mm)
    label rod_length(131.9 * units.mm)
    label rod_mass(360 * units.g)
    label compression_height(25.9 * units.mm)
    label crank_mass(12.0 * units.lb)
    label flywheel_mass(6.9 * units.lb)
    label flywheel_radius(6 * units.inch)
    label crank_moment(1.5 * disk_moment_of_inertia(mass: crank_mass, radius: stroke))
    label flywheel_moment(disk_moment_of_inertia(mass: flywheel_mass, radius: flywheel_radius))
    label other_moment(disk_moment_of_inertia(mass: 1 * units.kg, radius: 1.0 * units.cm))

    crankshaft c0(
        throw: stroke / 2,
        flywheel_mass: flywheel_mass,
        mass: crank_mass,
        friction_torque: 5.6 * units.lb_ft,
        moment_of_inertia: crank_moment + flywheel_moment + other_moment,
        position_x: 0.0,
        position_y: 0.0,
        tdc: 90.0 * units.deg
    )

    rod_journal rj1(angle: 0.000 * units.deg)
    rod_journal rj2(angle: 180.000 * units.deg)
    rod_journal rj3(angle: 180.000 * units.deg)
    rod_journal rj4(angle: 0.000 * units.deg)
    c0
        .add_rod_journal(rj1)
        .add_rod_journal(rj2)
        .add_rod_journal(rj3)
        .add_rod_journal(rj4)

    piston_parameters piston_params(
        mass: 240 * units.g,
        compression_height: compression_height,
        wrist_pin_position: 0.0,
        displacement: 0.0
    )
    connecting_rod_parameters cr_params(
        mass: rod_mass,
        moment_of_inertia: rod_moment_of_inertia(mass: rod_mass, length: rod_length),
        center_of_mass: 0.0,
        length: rod_length
    )

    intake intake(
        plenum_volume: 0.368 * units.L,
        plenum_cross_section_area: 8.0 * units.cm2,
        intake_flow_rate: k_carb(236.1),
        runner_flow_rate: k_carb(67.9),
        runner_length: 12.0 * units.inch,
        idle_flow_rate: k_carb(0.0),
        idle_throttle_plate_position: 0.996,
        velocity_decay: 0.5
    )

    exhaust_system_parameters es_params(
        outlet_flow_rate: k_carb(337.6),
        primary_tube_length: 20 * units.inch,
        primary_flow_rate: k_carb(167.6),
        velocity_decay: 1.0
    )
    exhaust_system exhaust0(es_params, audio_volume: 1.6,
        length: 130 * units.inch, impulse_response: ir_lib.mild_exhaust_0_reverb)

    cylinder_bank_parameters bank_params(
        bore: bore,
        deck_height: stroke / 2 + rod_length + compression_height
    )
    cylinder_bank b0(bank_params, angle: 0.0 * units.deg)
    b0
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.1)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj1,
            intake: intake,
            exhaust_system: exhaust0,
            ignition_wire: wires.wire1,
            sound_attenuation: 1.0,
            primary_length: 10 * units.inch
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.1)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj2,
            intake: intake,
            exhaust_system: exhaust0,
            ignition_wire: wires.wire2,
            sound_attenuation: 1.0,
            primary_length: 8 * units.inch
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.1)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj3,
            intake: intake,
            exhaust_system: exhaust0,
            ignition_wire: wires.wire3,
            sound_attenuation: 1.0,
            primary_length: 6 * units.inch
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.1)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj4,
            intake: intake,
            exhaust_system: exhaust0,
            ignition_wire: wires.wire4,
            sound_attenuation: 1.0,
            primary_length: 4 * units.inch
        )
        .set_cylinder_head(head(intake_camshaft: camshaft.intake0, exhaust_camshaft: camshaft.exhaust0, flip_display: false))

    engine
        .add_cylinder_bank(b0)
    engine.add_crankshaft(c0)

    camshafts camshaft()
    function timing_curve(1000 * units.rpm)
    timing_curve
        .add_sample(0 * units.rpm, 10.0 * units.deg)
        .add_sample(1000 * units.rpm, 16.8 * units.deg)
        .add_sample(2000 * units.rpm, 23.7 * units.deg)
        .add_sample(3000 * units.rpm, 30.5 * units.deg)
        .add_sample(4000 * units.rpm, 36.0 * units.deg)
        .add_sample(5000 * units.rpm, 36.0 * units.deg)
        .add_sample(6000 * units.rpm, 36.0 * units.deg)
        .add_sample(7000 * units.rpm, 36.0 * units.deg)
        .add_sample(8000 * units.rpm, 36.0 * units.deg)
    ignition_module ignition_module(timing_curve: timing_curve,
        rev_limit: 7900 * units.rpm, limiter_duration: 0.1)
    ignition_module
        .connect_wire(wires.wire1, 0.000 * units.deg)
        .connect_wire(wires.wire2, 180.000 * units.deg)
        .connect_wire(wires.wire4, 360.000 * units.deg)
        .connect_wire(wires.wire3, 540.000 * units.deg)
    engine.add_ignition_module(ignition_module)
}

private node mtes_vehicle {
    alias output __out:
        vehicle(mass: 1600 * units.kg, drag_coefficient: 0.3,
            cross_sectional_area: (72 * units.inch) * (50 * units.inch),
            diff_ratio: 3.42, tire_radius: 10 * units.inch, rolling_resistance: 200 * units.N);
}
private node mtes_transmission {
    alias output __out:
        transmission(max_clutch_torque: 2000 * units.lb_ft)
        .add_gear(2.97).add_gear(2.07).add_gear(1.43).add_gear(1.00).add_gear(0.71);
}
public node main {
    set_engine(ford_kent_16())
    set_vehicle(mtes_vehicle())
    set_transmission(mtes_transmission())
}

main()

// mtes-real-spec-profile: 1
// mtes-fuel-load-control: 1
import "engine_sim.mr"

units units()
constants constants()

private node motor_town_flame_speed {
    alias output __out:
        function(5.0)
            .add_sample(0.0, 27.0000)
            .add_sample(5.0, 67.5000)
            .add_sample(10.0, 135.0000)
            .add_sample(15.0, 202.5000)
            .add_sample(20.0, 270.0000)
            .add_sample(25.0, 337.5000)
            .add_sample(30.0, 405.0000)
            .add_sample(35.0, 472.5000)
            .add_sample(40.0, 540.0000)
            .add_sample(45.0, 607.5000);
}

public node motor_town_engine {
    alias output __out: engine;

    engine engine(
        name: "Volvo TAD881-VE 7.7 I6 diesel",
        starter_torque: 200 * units.lb_ft,
        starter_speed: 200 * units.rpm,
        redline: 2300 * units.rpm,
        throttle_gamma: 2.0,
        fuel: fuel(name: "Diesel", molecular_mass: 167 * units.g, energy_density: 45.5 * units.kJ / units.g, density: 0.832 * units.kg / units.L, molecular_afr: 17.75, turbulence_to_flame_speed_ratio: motor_town_flame_speed(), max_burning_efficiency: 0.44),
        simulation_frequency: 10000
    )

    crankshaft c0(
        throw: 0.067500 * units.m,
        flywheel_mass: 20.865 * units.kg,
        mass: 30.791 * units.kg,
        friction_torque: 24.502 * units.N * units.m,
        moment_of_inertia: 0.746098 * units.kg * units.m * units.m,
        position_x: 0.0, position_y: 0.0,
        tdc: 90.0000 * units.deg
    )
    rod_journal rj1(angle: 0.0000 * units.deg)
    c0.add_rod_journal(rj1)
    rod_journal rj2(angle: 120.0000 * units.deg)
    c0.add_rod_journal(rj2)
    rod_journal rj3(angle: 240.0000 * units.deg)
    c0.add_rod_journal(rj3)
    rod_journal rj4(angle: 240.0000 * units.deg)
    c0.add_rod_journal(rj4)
    rod_journal rj5(angle: 120.0000 * units.deg)
    c0.add_rod_journal(rj5)
    rod_journal rj6(angle: 0.0000 * units.deg)
    c0.add_rod_journal(rj6)
    engine.add_crankshaft(c0)

    piston_parameters piston_params(mass: 599.0 * units.g,
        compression_height: 0.036300 * units.m,
        wrist_pin_position: 0.0, displacement: 0.0)
    connecting_rod_parameters rod_params(mass: 389.3 * units.g,
        moment_of_inertia: 0.00160975 * units.kg * units.m * units.m,
        center_of_mass: 0.0, length: 0.222750 * units.m)
    intake intake(
        plenum_volume: 7.6977 * units.L,
        plenum_cross_section_area: 192.134 * units.cm2,
        intake_flow_rate: k_carb(1875.7),
        runner_flow_rate: k_carb(1994.5),
        molecular_afr: 32.1719,
        runner_length: 0.25 * units.m,
        idle_flow_rate: k_carb(0.0),
        idle_throttle_plate_position: 0.995,
        velocity_decay: 0.5)
    exhaust_system_parameters exhaust_params(
        collector_cross_section_area: 81.713 * units.cm2,
        length: 2.500 * units.m,
        outlet_flow_rate: k_carb(5089.6),
        primary_tube_length: 0.300 * units.m,
        primary_flow_rate: k_carb(1276.5),
        velocity_decay: 1.0, audio_volume: 1.0)
    impulse_response car_exhaust(filename: "exhaust/2019_konecranes_smv_25_1200_c.wav", volume: 0.02860783)
    exhaust_system exhaust0(exhaust_params, impulse_response: car_exhaust)

    function intake_flow(50 * units.thou)
    intake_flow.add_sample(0 * units.thou, k_28inH2O(0.00))
    intake_flow.add_sample(50 * units.thou, k_28inH2O(46.84))
    intake_flow.add_sample(100 * units.thou, k_28inH2O(93.69))
    intake_flow.add_sample(150 * units.thou, k_28inH2O(140.53))
    intake_flow.add_sample(200 * units.thou, k_28inH2O(187.37))
    intake_flow.add_sample(250 * units.thou, k_28inH2O(234.21))
    intake_flow.add_sample(300 * units.thou, k_28inH2O(281.06))
    intake_flow.add_sample(350 * units.thou, k_28inH2O(310.38))
    intake_flow.add_sample(400 * units.thou, k_28inH2O(310.38))
    intake_flow.add_sample(450 * units.thou, k_28inH2O(310.38))
    intake_flow.add_sample(500 * units.thou, k_28inH2O(310.38))
    intake_flow.add_sample(550 * units.thou, k_28inH2O(310.38))
    harmonic_cam_lobe intake_lobe(duration_at_50_thou: 202.67 * units.deg,
        gamma: 1.1, lift: 0.011088 * units.m, steps: 256)
    function exhaust_flow(50 * units.thou)
    exhaust_flow.add_sample(0 * units.thou, k_28inH2O(0.00))
    exhaust_flow.add_sample(50 * units.thou, k_28inH2O(37.47))
    exhaust_flow.add_sample(100 * units.thou, k_28inH2O(74.95))
    exhaust_flow.add_sample(150 * units.thou, k_28inH2O(112.42))
    exhaust_flow.add_sample(200 * units.thou, k_28inH2O(149.90))
    exhaust_flow.add_sample(250 * units.thou, k_28inH2O(187.37))
    exhaust_flow.add_sample(300 * units.thou, k_28inH2O(198.64))
    exhaust_flow.add_sample(350 * units.thou, k_28inH2O(198.64))
    exhaust_flow.add_sample(400 * units.thou, k_28inH2O(198.64))
    exhaust_flow.add_sample(450 * units.thou, k_28inH2O(198.64))
    exhaust_flow.add_sample(500 * units.thou, k_28inH2O(198.64))
    exhaust_flow.add_sample(550 * units.thou, k_28inH2O(198.64))
    harmonic_cam_lobe exhaust_lobe(duration_at_50_thou: 202.67 * units.deg,
        gamma: 1.1, lift: 0.011088 * units.m, steps: 256)

    camshaft intake_cam0(advance: 0.0, base_radius: 0.5 * units.inch, lobe_profile: intake_lobe, lobes_per_cycle: 1)
    camshaft exhaust_cam0(advance: 0.0, base_radius: 0.5 * units.inch, lobe_profile: exhaust_lobe, lobes_per_cycle: 1)
    cylinder_bank b0(angle: 0.0000 * units.deg, bore: 0.110000 * units.m,
        deck_height: 0.326550 * units.m)
    intake_cam0.add_lobe((472.0 + 0.0000) * units.deg)
    exhaust_cam0.add_lobe((248.0 + 0.0000) * units.deg)
    ignition_wire wire1()
    b0.add_cylinder(
        piston: piston(piston_params, blowby: k_28inH2O(0.0)),
        connecting_rod: connecting_rod(rod_params),
        rod_journal: rj1, intake: intake, exhaust_system: exhaust0,
        ignition_wire: wire1, sound_attenuation: 1.0,
        primary_length: 0.6825 * units.m)
    intake_cam0.add_lobe((472.0 + 480.0000) * units.deg)
    exhaust_cam0.add_lobe((248.0 + 480.0000) * units.deg)
    ignition_wire wire2()
    b0.add_cylinder(
        piston: piston(piston_params, blowby: k_28inH2O(0.0)),
        connecting_rod: connecting_rod(rod_params),
        rod_journal: rj2, intake: intake, exhaust_system: exhaust0,
        ignition_wire: wire2, sound_attenuation: 1.0,
        primary_length: 0.5560 * units.m)
    intake_cam0.add_lobe((472.0 + 240.0000) * units.deg)
    exhaust_cam0.add_lobe((248.0 + 240.0000) * units.deg)
    ignition_wire wire3()
    b0.add_cylinder(
        piston: piston(piston_params, blowby: k_28inH2O(0.0)),
        connecting_rod: connecting_rod(rod_params),
        rod_journal: rj3, intake: intake, exhaust_system: exhaust0,
        ignition_wire: wire3, sound_attenuation: 1.0,
        primary_length: 0.4295 * units.m)
    intake_cam0.add_lobe((472.0 + 600.0000) * units.deg)
    exhaust_cam0.add_lobe((248.0 + 600.0000) * units.deg)
    ignition_wire wire4()
    b0.add_cylinder(
        piston: piston(piston_params, blowby: k_28inH2O(0.0)),
        connecting_rod: connecting_rod(rod_params),
        rod_journal: rj4, intake: intake, exhaust_system: exhaust0,
        ignition_wire: wire4, sound_attenuation: 1.0,
        primary_length: 0.3030 * units.m)
    intake_cam0.add_lobe((472.0 + 120.0000) * units.deg)
    exhaust_cam0.add_lobe((248.0 + 120.0000) * units.deg)
    ignition_wire wire5()
    b0.add_cylinder(
        piston: piston(piston_params, blowby: k_28inH2O(0.0)),
        connecting_rod: connecting_rod(rod_params),
        rod_journal: rj5, intake: intake, exhaust_system: exhaust0,
        ignition_wire: wire5, sound_attenuation: 1.0,
        primary_length: 0.1765 * units.m)
    intake_cam0.add_lobe((472.0 + 360.0000) * units.deg)
    exhaust_cam0.add_lobe((248.0 + 360.0000) * units.deg)
    ignition_wire wire6()
    b0.add_cylinder(
        piston: piston(piston_params, blowby: k_28inH2O(0.0)),
        connecting_rod: connecting_rod(rod_params),
        rod_journal: rj6, intake: intake, exhaust_system: exhaust0,
        ignition_wire: wire6, sound_attenuation: 1.0,
        primary_length: 0.0500 * units.m)
    b0.set_cylinder_head(generic_cylinder_head(
        chamber_volume: 80.184 * units.cc,
        intake_runner_volume: 176.123 * units.cc,
        intake_runner_cross_section_area: 32.0224 * units.cm2,
        exhaust_runner_volume: 112.719 * units.cc,
        exhaust_runner_cross_section_area: 20.4943 * units.cm2,
        intake_port_flow: intake_flow, exhaust_port_flow: exhaust_flow,
        valvetrain: standard_valvetrain(intake_camshaft: intake_cam0, exhaust_camshaft: exhaust_cam0),
        flip_display: false))
    engine.add_cylinder_bank(b0)

    function timing_curve(1000 * units.rpm)
    timing_curve.add_sample(0 * units.rpm, 7.23 * units.deg)
    timing_curve.add_sample(500 * units.rpm, 7.23 * units.deg)
    timing_curve.add_sample(1000 * units.rpm, 7.23 * units.deg)
    timing_curve.add_sample(1500 * units.rpm, 7.23 * units.deg)
    timing_curve.add_sample(2000 * units.rpm, 7.23 * units.deg)
    timing_curve.add_sample(2500 * units.rpm, 7.23 * units.deg)
    timing_curve.add_sample(3000 * units.rpm, 7.23 * units.deg)
    timing_curve.add_sample(3500 * units.rpm, 7.23 * units.deg)
    timing_curve.add_sample(4000 * units.rpm, 7.23 * units.deg)
    ignition_module ignition_module(timing_curve: timing_curve, rev_limit: 2600 * units.rpm, limiter_duration: 0.1, sparks_per_cycle: 1)
    ignition_module.connect_wire(wire1, 0.0000 * units.deg)
    ignition_module.connect_wire(wire5, 120.0000 * units.deg)
    ignition_module.connect_wire(wire3, 240.0000 * units.deg)
    ignition_module.connect_wire(wire6, 360.0000 * units.deg)
    ignition_module.connect_wire(wire2, 480.0000 * units.deg)
    ignition_module.connect_wire(wire4, 600.0000 * units.deg)
    engine.add_ignition_module(ignition_module)
}

public node main {
    set_engine(motor_town_engine())
    set_vehicle(vehicle(mass: 1500 * units.kg, drag_coefficient: 0.35,
        cross_sectional_area: 2.0 * units.m * units.m, diff_ratio: 3.42,
        tire_radius: 0.33 * units.m, rolling_resistance: 200 * units.N))
    set_transmission(transmission(max_clutch_torque: 1000 * units.lb_ft).add_gear(1.0))
}

main()

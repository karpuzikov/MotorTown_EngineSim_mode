// mtes-real-spec-profile: 1
// mtes-fuel-load-control: 1
import "engine_sim.mr"

units units()
constants constants()

private node motor_town_flame_speed {
    alias output __out:
        function(5.0)
            .add_sample(0.0, 27.0000)
            .add_sample(5.0, 67.5000)
            .add_sample(10.0, 135.0000)
            .add_sample(15.0, 202.5000)
            .add_sample(20.0, 270.0000)
            .add_sample(25.0, 337.5000)
            .add_sample(30.0, 405.0000)
            .add_sample(35.0, 472.5000)
            .add_sample(40.0, 540.0000)
            .add_sample(45.0, 607.5000);
}

public node motor_town_engine {
    alias output __out: engine;

    engine engine(
        name: "Detroit Diesel 8V92TA two-stroke V8",
        starter_torque: 200 * units.lb_ft,
        starter_speed: 200 * units.rpm,
        redline: 2100 * units.rpm,
        throttle_gamma: 2.0,
        fuel: fuel(name: "Diesel", molecular_mass: 167 * units.g, energy_density: 45.5 * units.kJ / units.g, density: 0.832 * units.kg / units.L, molecular_afr: 17.75, turbulence_to_flame_speed_ratio: motor_town_flame_speed(), max_burning_efficiency: 0.44),
        simulation_frequency: 10000
    )

    crankshaft c0(
        throw: 0.063500 * units.m,
        flywheel_mass: 28.591 * units.kg,
        mass: 48.290 * units.kg,
        friction_torque: 38.428 * units.N * units.m,
        moment_of_inertia: 1.094207 * units.kg * units.m * units.m,
        position_x: 0.0, position_y: 0.0,
        tdc: 58.2500 * units.deg
    )
    rod_journal rj1(angle: 0.0000 * units.deg)
    c0.add_rod_journal(rj1)
    rod_journal rj2(angle: 270.0000 * units.deg)
    c0.add_rod_journal(rj2)
    rod_journal rj3(angle: 90.0000 * units.deg)
    c0.add_rod_journal(rj3)
    rod_journal rj4(angle: 180.0000 * units.deg)
    c0.add_rod_journal(rj4)
    rod_journal rj5(angle: 18.5000 * units.deg)
    c0.add_rod_journal(rj5)
    rod_journal rj6(angle: 288.5000 * units.deg)
    c0.add_rod_journal(rj6)
    rod_journal rj7(angle: 108.5000 * units.deg)
    c0.add_rod_journal(rj7)
    rod_journal rj8(angle: 198.5000 * units.deg)
    c0.add_rod_journal(rj8)
    engine.add_crankshaft(c0)

    piston_parameters piston_params(mass: 837.4 * units.g,
        compression_height: 0.040590 * units.m,
        wrist_pin_position: 0.0, displacement: 0.0)
    connecting_rod_parameters rod_params(mass: 544.3 * units.g,
        moment_of_inertia: 0.00199175 * units.kg * units.m * units.m,
        center_of_mass: 0.0, length: 0.209550 * units.m)
    intake intake(
        plenum_volume: 1.2072 * units.L,
        plenum_cross_section_area: 726.916 * units.cm2,
        intake_flow_rate: k_carb(2685.9),
        runner_flow_rate: k_carb(5659.6),
        molecular_afr: 32.1719,
        runner_length: 0.25 * units.m,
        idle_flow_rate: k_carb(0.0),
        idle_throttle_plate_position: 0.99045,
        velocity_decay: 0.5)
    exhaust_system_parameters exhaust_params(
        collector_cross_section_area: 126.677 * units.cm2,
        length: 2.500 * units.m,
        outlet_flow_rate: k_carb(7890.2),
        primary_tube_length: 0.300 * units.m,
        primary_flow_rate: k_carb(4987.7),
        velocity_decay: 1.0, audio_volume: 1.0)
    impulse_response car_exhaust(filename: "exhaust/1985_freightliner_fla.wav", volume: 0.02107712)
    exhaust_system exhaust0(exhaust_params, impulse_response: car_exhaust)

    function intake_flow(50 * units.thou)
    intake_flow.add_sample(0 * units.thou, k_28inH2O(0.00))
    intake_flow.add_sample(50 * units.thou, k_28inH2O(55.80))
    intake_flow.add_sample(100 * units.thou, k_28inH2O(111.59))
    intake_flow.add_sample(150 * units.thou, k_28inH2O(167.39))
    intake_flow.add_sample(200 * units.thou, k_28inH2O(223.18))
    intake_flow.add_sample(250 * units.thou, k_28inH2O(278.98))
    intake_flow.add_sample(300 * units.thou, k_28inH2O(334.77))
    intake_flow.add_sample(350 * units.thou, k_28inH2O(390.57))
    intake_flow.add_sample(400 * units.thou, k_28inH2O(446.36))
    intake_flow.add_sample(450 * units.thou, k_28inH2O(502.16))
    intake_flow.add_sample(500 * units.thou, k_28inH2O(557.95))
    intake_flow.add_sample(550 * units.thou, k_28inH2O(613.75))
    intake_flow.add_sample(600 * units.thou, k_28inH2O(669.54))
    intake_flow.add_sample(650 * units.thou, k_28inH2O(725.34))
    intake_flow.add_sample(700 * units.thou, k_28inH2O(781.13))
    intake_flow.add_sample(750 * units.thou, k_28inH2O(836.93))
    intake_flow.add_sample(800 * units.thou, k_28inH2O(880.71))
    intake_flow.add_sample(850 * units.thou, k_28inH2O(880.71))
    intake_flow.add_sample(900 * units.thou, k_28inH2O(880.71))
    intake_flow.add_sample(950 * units.thou, k_28inH2O(880.71))
    intake_flow.add_sample(1000 * units.thou, k_28inH2O(880.71))
    intake_flow.add_sample(1050 * units.thou, k_28inH2O(880.71))
    harmonic_cam_lobe intake_lobe(duration_at_50_thou: 96.00 * units.deg,
        gamma: 1.1, lift: 0.023584 * units.m, steps: 256)
    function exhaust_flow(50 * units.thou)
    exhaust_flow.add_sample(0 * units.thou, k_28inH2O(0.00))
    exhaust_flow.add_sample(50 * units.thou, k_28inH2O(104.76))
    exhaust_flow.add_sample(100 * units.thou, k_28inH2O(209.51))
    exhaust_flow.add_sample(150 * units.thou, k_28inH2O(314.27))
    exhaust_flow.add_sample(200 * units.thou, k_28inH2O(419.03))
    exhaust_flow.add_sample(250 * units.thou, k_28inH2O(523.79))
    exhaust_flow.add_sample(300 * units.thou, k_28inH2O(628.54))
    exhaust_flow.add_sample(350 * units.thou, k_28inH2O(733.30))
    exhaust_flow.add_sample(400 * units.thou, k_28inH2O(776.15))
    exhaust_flow.add_sample(450 * units.thou, k_28inH2O(776.15))
    exhaust_flow.add_sample(500 * units.thou, k_28inH2O(776.15))
    exhaust_flow.add_sample(550 * units.thou, k_28inH2O(776.15))
    exhaust_flow.add_sample(600 * units.thou, k_28inH2O(776.15))
    harmonic_cam_lobe exhaust_lobe(duration_at_50_thou: 146.00 * units.deg,
        gamma: 1.1, lift: 0.012398 * units.m, steps: 256)

    camshaft intake_cam0(advance: 0.0, base_radius: 0.5 * units.inch, lobe_profile: intake_lobe, lobes_per_cycle: 2)
    camshaft exhaust_cam0(advance: 0.0, base_radius: 0.5 * units.inch, lobe_profile: exhaust_lobe, lobes_per_cycle: 2)
    cylinder_bank b0(angle: -31.7500 * units.deg, bore: 0.123000 * units.m,
        deck_height: 0.313640 * units.m)
    intake_cam0.add_lobe((180.0 + 0.0000) * units.deg)
    exhaust_cam0.add_lobe((165.0 + 0.0000) * units.deg)
    ignition_wire wire1()
    b0.add_cylinder(
        piston: piston(piston_params, blowby: k_28inH2O(0.0)),
        connecting_rod: connecting_rod(rod_params),
        rod_journal: rj1, intake: intake, exhaust_system: exhaust0,
        ignition_wire: wire1, sound_attenuation: 1.0,
        primary_length: 0.4743 * units.m)
    intake_cam0.add_lobe((180.0 + 270.0000) * units.deg)
    exhaust_cam0.add_lobe((165.0 + 270.0000) * units.deg)
    ignition_wire wire2()
    b0.add_cylinder(
        piston: piston(piston_params, blowby: k_28inH2O(0.0)),
        connecting_rod: connecting_rod(rod_params),
        rod_journal: rj2, intake: intake, exhaust_system: exhaust0,
        ignition_wire: wire2, sound_attenuation: 1.0,
        primary_length: 0.3329 * units.m)
    intake_cam0.add_lobe((180.0 + 90.0000) * units.deg)
    exhaust_cam0.add_lobe((165.0 + 90.0000) * units.deg)
    ignition_wire wire3()
    b0.add_cylinder(
        piston: piston(piston_params, blowby: k_28inH2O(0.0)),
        connecting_rod: connecting_rod(rod_params),
        rod_journal: rj3, intake: intake, exhaust_system: exhaust0,
        ignition_wire: wire3, sound_attenuation: 1.0,
        primary_length: 0.1915 * units.m)
    intake_cam0.add_lobe((180.0 + 180.0000) * units.deg)
    exhaust_cam0.add_lobe((165.0 + 180.0000) * units.deg)
    ignition_wire wire4()
    b0.add_cylinder(
        piston: piston(piston_params, blowby: k_28inH2O(0.0)),
        connecting_rod: connecting_rod(rod_params),
        rod_journal: rj4, intake: intake, exhaust_system: exhaust0,
        ignition_wire: wire4, sound_attenuation: 1.0,
        primary_length: 0.0500 * units.m)
    b0.set_cylinder_head(generic_cylinder_head(
        chamber_volume: 94.316 * units.cc,
        intake_runner_volume: 558.817 * units.cc,
        intake_runner_cross_section_area: 90.8646 * units.cm2,
        exhaust_runner_volume: 492.474 * units.cc,
        exhaust_runner_cross_section_area: 80.0771 * units.cm2,
        intake_port_flow: intake_flow, exhaust_port_flow: exhaust_flow,
        valvetrain: standard_valvetrain(intake_camshaft: intake_cam0, exhaust_camshaft: exhaust_cam0),
        flip_display: false))
    engine.add_cylinder_bank(b0)

    camshaft intake_cam1(advance: 0.0, base_radius: 0.5 * units.inch, lobe_profile: intake_lobe, lobes_per_cycle: 2)
    camshaft exhaust_cam1(advance: 0.0, base_radius: 0.5 * units.inch, lobe_profile: exhaust_lobe, lobes_per_cycle: 2)
    cylinder_bank b1(angle: 31.7500 * units.deg, bore: 0.123000 * units.m,
        deck_height: 0.313640 * units.m)
    intake_cam1.add_lobe((180.0 + 315.0000) * units.deg)
    exhaust_cam1.add_lobe((165.0 + 315.0000) * units.deg)
    ignition_wire wire5()
    b1.add_cylinder(
        piston: piston(piston_params, blowby: k_28inH2O(0.0)),
        connecting_rod: connecting_rod(rod_params),
        rod_journal: rj5, intake: intake, exhaust_system: exhaust0,
        ignition_wire: wire5, sound_attenuation: 1.0,
        primary_length: 0.4743 * units.m)
    intake_cam1.add_lobe((180.0 + 225.0000) * units.deg)
    exhaust_cam1.add_lobe((165.0 + 225.0000) * units.deg)
    ignition_wire wire6()
    b1.add_cylinder(
        piston: piston(piston_params, blowby: k_28inH2O(0.0)),
        connecting_rod: connecting_rod(rod_params),
        rod_journal: rj6, intake: intake, exhaust_system: exhaust0,
        ignition_wire: wire6, sound_attenuation: 1.0,
        primary_length: 0.3329 * units.m)
    intake_cam1.add_lobe((180.0 + 45.0000) * units.deg)
    exhaust_cam1.add_lobe((165.0 + 45.0000) * units.deg)
    ignition_wire wire7()
    b1.add_cylinder(
        piston: piston(piston_params, blowby: k_28inH2O(0.0)),
        connecting_rod: connecting_rod(rod_params),
        rod_journal: rj7, intake: intake, exhaust_system: exhaust0,
        ignition_wire: wire7, sound_attenuation: 1.0,
        primary_length: 0.1915 * units.m)
    intake_cam1.add_lobe((180.0 + 135.0000) * units.deg)
    exhaust_cam1.add_lobe((165.0 + 135.0000) * units.deg)
    ignition_wire wire8()
    b1.add_cylinder(
        piston: piston(piston_params, blowby: k_28inH2O(0.0)),
        connecting_rod: connecting_rod(rod_params),
        rod_journal: rj8, intake: intake, exhaust_system: exhaust0,
        ignition_wire: wire8, sound_attenuation: 1.0,
        primary_length: 0.0500 * units.m)
    b1.set_cylinder_head(generic_cylinder_head(
        chamber_volume: 94.316 * units.cc,
        intake_runner_volume: 558.817 * units.cc,
        intake_runner_cross_section_area: 90.8646 * units.cm2,
        exhaust_runner_volume: 492.474 * units.cc,
        exhaust_runner_cross_section_area: 80.0771 * units.cm2,
        intake_port_flow: intake_flow, exhaust_port_flow: exhaust_flow,
        valvetrain: standard_valvetrain(intake_camshaft: intake_cam1, exhaust_camshaft: exhaust_cam1),
        flip_display: true))
    engine.add_cylinder_bank(b1)

    function timing_curve(1000 * units.rpm)
    timing_curve.add_sample(0 * units.rpm, 6.38 * units.deg)
    timing_curve.add_sample(500 * units.rpm, 6.38 * units.deg)
    timing_curve.add_sample(1000 * units.rpm, 6.38 * units.deg)
    timing_curve.add_sample(1500 * units.rpm, 6.80 * units.deg)
    timing_curve.add_sample(2000 * units.rpm, 7.23 * units.deg)
    timing_curve.add_sample(2500 * units.rpm, 9.98 * units.deg)
    timing_curve.add_sample(3000 * units.rpm, 9.98 * units.deg)
    timing_curve.add_sample(3500 * units.rpm, 9.98 * units.deg)
    timing_curve.add_sample(4000 * units.rpm, 9.98 * units.deg)
    ignition_module ignition_module(timing_curve: timing_curve, rev_limit: 2400 * units.rpm, limiter_duration: 0.1, sparks_per_cycle: 2)
    ignition_module.connect_wire(wire1, 0.0000 * units.deg)
    ignition_module.connect_wire(wire7, 45.0000 * units.deg)
    ignition_module.connect_wire(wire3, 90.0000 * units.deg)
    ignition_module.connect_wire(wire8, 135.0000 * units.deg)
    ignition_module.connect_wire(wire4, 180.0000 * units.deg)
    ignition_module.connect_wire(wire6, 225.0000 * units.deg)
    ignition_module.connect_wire(wire2, 270.0000 * units.deg)
    ignition_module.connect_wire(wire5, 315.0000 * units.deg)
    engine.add_ignition_module(ignition_module)
}

public node main {
    set_engine(motor_town_engine())
    set_vehicle(vehicle(mass: 1500 * units.kg, drag_coefficient: 0.35,
        cross_sectional_area: 2.0 * units.m * units.m, diff_ratio: 3.42,
        tire_radius: 0.33 * units.m, rolling_resistance: 200 * units.N))
    set_transmission(transmission(max_clutch_torque: 1000 * units.lb_ft).add_gear(1.0))
}

main()
